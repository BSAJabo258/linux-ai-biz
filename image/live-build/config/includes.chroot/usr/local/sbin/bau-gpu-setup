  "21500408b5019d8d29f70ce58488e2eea469a1adb4b5fd7db45e819b5efcac4e  gcc-14_14.2.0-19_amd64.deb"
  "34bfb96ca9422af293aeac800438682112b4019adc5ed25728bc35dff4ad4ca4  libefivar1t64_38-3.1+b1_amd64.deb"
  "78e6197dbf5cbf13813076369e9589f81591d28bbe2638526a131b6db5e3b7c0  libnvidia-rtcore_550.163.01-2_amd64.deb"
  "08b8b559ab1707dc146880d329f1e96f011788a18d6d3dc7159accd488ae2712  pahole_1.30-1_amd64.deb"
  "1918fd2775b06e35429a06c59586d548bcccd6c544684799a22ae532a8bb83e4  mokutil_0.7.2-1_amd64.deb"
  "68131339e5df5553e14b29f6d25947cb448b2d9ce390297b705b557920efa787  nvidia-vulkan-common_550.163.01-2_amd64.deb"
  "5da88f6434706800a0c0b6c5c8d723af6e3251c8f9bc522da548dbb9b6389267  nvidia-vulkan-icd_550.163.01-2_amd64.deb"
)

# Tests only: another pin list (sudo clears the environment, so a real run uses the one above).
if [[ -n ${BAU_OFFLINE_PINS:-} ]]; then mapfile -t OFFLINE_PINS < "${BAU_OFFLINE_PINS}"; fi

say() { printf '%s\n' "$*"; }

find_pack() {
  local d
  for d in "${BAU_NVIDIA_PACK:-}" "$(dirname "$(readlink -f "$0")")" /media/*/*/BAU-PACK/nvidia \
           /media/*/BAU-PACK/nvidia /run/media/*/*/BAU-PACK/nvidia /mnt/BAU-PACK/nvidia \
           /mnt/*/BAU-PACK/nvidia; do
    if [[ -n ${d} && -f ${d}/KERNEL ]]; then printf '%s\n' "${d}"; return 0; fi
  done
  return 1
}

if [[ $(id -u) -ne 0 ]]; then
  say "Run it with sudo: sudo bau-gpu-setup"; exit 1
fi
if [[ -d ${LIVE} ]]; then
  say "This is the live stick: the driver and its key would be gone at the next restart."
  say "Install BAU to a disk first, start from that disk, then run this again."
  exit 1
fi

card=""
for dev in "${SYSFS}"/*; do
  [[ -r ${dev}/vendor && -r ${dev}/class ]] || continue
  if [[ $(<"${dev}/vendor") == 0x10de && $(<"${dev}/class") == 0x03* ]]; then
    card=${dev##*/}; break
  fi
done
if [[ -z ${card} ]]; then
  say "No NVIDIA graphics card found: nothing to do (BAU uses the processor)."; exit 1
fi

# Without the internet apt only warns, then says "Unable to locate package nvidia-driver"
# (the owner's desktop, 2026-10-27). Use the pack's copy, or say the real reason.
offline=""
if ! getent hosts deb.debian.org >/dev/null 2>&1; then
  offline=$(find_pack) || {
    say "No internet: this computer cannot reach deb.debian.org, where the driver comes from."
    say "Either plug in the network cable (or pick your Wi-Fi) and run this again, or plug in"
    say "a BAU Pack stick made with the newest bau-pack-make.ps1: it carries the driver."
    exit 1
  }
  if [[ $(uname -r) != "${OFFLINE_KERNEL}" ]]; then
    say "The driver on the stick is built for Linux ${OFFLINE_KERNEL}; this computer runs"
    say "$(uname -r). Connect to the internet (cable or Wi-Fi) and run this again."
    exit 1
  fi
  if ! (cd "${offline}" && printf '%s\n' "${OFFLINE_PINS[@]}" | sha256sum -c --quiet --strict \
        >/dev/null 2>&1); then
    say "The driver files on the stick are missing or damaged (${offline}). Make the pack"
    say "again on Windows (bau-pack-make.ps1), then run this again. Nothing was changed."
    exit 1
  fi
fi

say "NVIDIA graphics card found (${card})."
if [[ -n ${offline} ]]; then
  say "No internet, so it uses the driver files on the stick (${offline}): Debian's NVIDIA"
  say "driver 550.163.01, built for this computer's Linux and signed with this computer's own"
  say "key. Then you restart. It takes a few minutes."
else
  say "This installs Debian's NVIDIA driver 550.163.01 and the newest Debian kernel, builds"
  say "the driver for this computer and signs it with this computer's own key. Then you"
  say "restart. It needs the internet and takes a few minutes."
fi
read -r -p "Go ahead? Type y and Enter (anything else: no): " answer || answer=""
if [[ ${answer} != y ]]; then
  say "Nothing was changed."; exit 1
fi

export DEBIAN_FRONTEND=noninteractive
if [[ -n ${offline} ]]; then
  files=()
  for p in "${OFFLINE_PINS[@]}"; do files+=("${offline}/${p##* }"); done
  apt-get install -y -q --no-install-recommends "${files[@]}"
else
apt-get update -q
if ! apt-cache policy nvidia-driver | grep -q 'Candidate: [0-9]'; then
  say "Adding Debian's contrib, non-free and non-free-firmware areas (${SOURCES})..."
  cat > "${SOURCES}" <<'EOF'
# Added by bau-gpu-setup: Debian's own non-free area, for the NVIDIA driver.
Types: deb
URIs: http://deb.debian.org/debian
Suites: trixie trixie-updates
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

Types: deb
URIs: http://deb.debian.org/debian-security
Suites: trixie-security
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
EOF
  apt-get update -q
fi
apt-get install -y -q "${PACKAGES[@]}"
fi

sb=$(mokutil --sb-state 2>&1 || true)
if [[ ${sb} == *"SecureBoot enabled"* ]]; then
  # mokutil 0.7.2's own words (strings of /usr/bin/mokutil in debian:trixie, 2026-10-25):
  # "%s is not enrolled", "%s is already in the enrollment request".
  key=$(mokutil --test-key "${PUB}" 2>&1 || true)
  if [[ ${key} == *"enrollment request"* ]]; then
    say "Secure Boot: the key is waiting. Restart and finish the blue screen (Enroll MOK)."
  elif [[ ${key} != *"is not enrolled"* ]]; then
    say "Secure Boot: this computer's driver key is already enrolled."
  else
    say ""
    say "Secure Boot is on, so the card needs this computer's driver key enrolled once."
    say "Choose a short one-time password now and type it twice (you need it once more"
    say "after the restart, then never again):"
    mokutil --import "${PUB}"
    say ""
    say "After the restart a blue screen appears (MOK management). Press a key, then choose"
    say "Enroll MOK, Continue, Yes, type the password, and OK. The computer starts normally."
  fi
fi

say ""
say "Done. Restart now so the driver starts: sudo systemctl reboot"
say "Afterwards, check it with: nvidia-smi"
