#!/bin/bash
# The BAU look on the desktop (docs/LOOK.md). At your first login only: BAU's art on the
# desktop (it changes every 10 minutes between the pictures in /usr/share/backgrounds/bau)
# and the dark theme. After that it never touches your choices: change them in Settings.
set -u
# v3: v1 and v2 never took on a new Xfce desktop (see below), so the look is applied again.
mark="${XDG_CONFIG_HOME:-${HOME}/.config}/bau/look-applied-v3"
[[ -e ${mark} ]] && exit 0
command -v xfconf-query >/dev/null && command -v xrandr >/dev/null || exit 0
art=${BAU_LOOK_ART:-/usr/share/backgrounds/bau/wall-dusk.jpg}
[[ -f ${art} ]] || exit 0

xfconf-query -c xsettings -p /Net/ThemeName -n -t string -s Adwaita-dark

# A new Xfce desktop (xfdesktop 4.20.1, Debian 13) shows its own default picture without
# storing any picture setting, so there is nothing to change: tested 2026-10-26 in Debian
# 13 with Xvfb, the old version of this script waited, found nothing and left the Xfce
# mouse every time. So BAU writes the setting itself, for every screen RandR names
# (xfdesktop's key is .../monitor<RandR name>/workspace<N>/last-image) and every
# workspace, waiting up to 30 s for the desktop and the screens to be there.
images=()
for _ in $(seq 30); do
  if xfconf-query -c xfce4-desktop -l >/dev/null 2>&1; then
    mapfile -t monitors < <(xrandr --listmonitors 2>/dev/null | awk 'NR > 1 {print $NF}')
    ((${#monitors[@]})) && break
  fi
  sleep 1
done
((${#monitors[@]})) || exit 0        # no desktop or no screens yet: try at the next login
spaces=$(xfconf-query -c xfwm4 -p /general/workspace_count 2>/dev/null || echo 4)
[[ ${spaces} =~ ^[0-9]+$ ]] && ((spaces > 0)) || spaces=4
for m in "${monitors[@]}"; do
  for ((w = 0; w < spaces; w++)); do
    images+=("/backdrop/screen0/monitor${m}/workspace${w}/last-image")
  done
done
mapfile -t -O "${#images[@]}" images < <(xfconf-query -c xfce4-desktop -l 2>/dev/null \
  | grep '/last-image$')
for p in $(printf '%s\n' "${images[@]}" | sort -u); do
  base=${p%/last-image}
  xfconf-query -c xfce4-desktop -p "${p}" -n -t string -s "${art}"
  xfconf-query -c xfce4-desktop -p "${base}/image-style" -n -t int -s 5
  xfconf-query -c xfce4-desktop -p "${base}/backdrop-cycle-enable" -n -t bool -s true
  xfconf-query -c xfce4-desktop -p "${base}/backdrop-cycle-period" -n -t int -s 1
  xfconf-query -c xfce4-desktop -p "${base}/backdrop-cycle-timer" -n -t uint -s 10
done
mkdir -p "${mark%/*}" && date -u +%FT%TZ > "${mark}"
