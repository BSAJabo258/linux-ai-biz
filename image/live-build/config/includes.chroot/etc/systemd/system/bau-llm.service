[Unit]
Description=My Jarvis local model (llama.cpp llama-server on 127.0.0.1:8080)
ConditionPathExists=/etc/bau/llm.env
# Bad settings or port 8080 taken: give up after 3 tries in 5 minutes instead of
# reloading the model from the stick every 5 seconds forever.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
User=bau
Group=bau
# Qwen3.5 thinks out loud by default: on this laptop CPU "Say hello" took 190 s and
# came back empty (llama-server v0.6.0, 2026-10-21). Off, it answered and used a tool in
# 15 s. LLAMA_ARG_REASONING is llama-server's env for --reasoning; /etc/bau/llm.env can
# set it back to on.
Environment=LLAMA_ARG_REASONING=off
# The server keeps old prompts in RAM to reuse them; its default allowance is 8 GB, the
# laptop's whole memory (llama-server v0.6.0 --help, 2026-10-21). 1 GB is plenty for
# Jarvis's prompt.
Environment=LLAMA_ARG_CACHE_RAM=1024
# BAU_LLM_MODEL (path to the .gguf) and BAU_LLM_ALIAS, written by jarvis-setup.
EnvironmentFile=/etc/bau/llm.env
Environment=LD_LIBRARY_PATH=/opt/llama.cpp
# bau-llm-start leaves one processor core free for the desktop and the Jarvis page (on every
# core the model ran 30 times slower while the page was open, 2026-10-21).
ExecStart=/usr/local/bin/bau-llm-start --model ${BAU_LLM_MODEL} --alias ${BAU_LLM_ALIAS} \
  --jinja --host 127.0.0.1 --port 8080 --ctx-size 8192 --no-webui
Restart=on-failure
# When memory runs out (the live stick's system space is RAM too), Linux stops this
# model first instead of the desktop or the terminal; it restarts by itself.
OOMScoreAdjust=500
RestartSec=5
UMask=0007
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/bau
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
