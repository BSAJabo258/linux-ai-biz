# Live system
live-boot
live-config
live-config-systemd
cryptsetup
cryptsetup-initramfs
sudo
user-setup

# Desktop (light: 8 GB machines)
xfce4
xfce4-terminal
# The X server and the login screen: only "recommended" by xfce4/lightdm, and recommends
# are off, so they must be named or LightDM fails at boot. xserver-xorg brings every
# video and input driver (xserver-xorg-video-all, -input-all).
xserver-xorg
xserver-xorg-core
lightdm
lightdm-gtk-greeter
firefox-esr
network-manager
network-manager-gnome
# Wi-Fi: network-manager only recommends these, and auto/config turns recommends off.
# Without wpasupplicant NetworkManager cannot use Wi-Fi at all.
wpasupplicant
wireless-regdb
iw
# Sticks and Windows drives open by themselves when plugged in (Thunar), exFAT and NTFS
# included; screen and power handled (without it the screen blanks after 10 minutes).
thunar-volman
gvfs-backends
exfatprogs
ntfs-3g
xfce4-power-manager
# Compressed swap in memory instead of on disk (/etc/systemd/zram-generator.conf).
systemd-zram-generator
fonts-dejavu
dbus-x11

# BAU control plane and its host protections
python3
python3-venv
python3-yaml
nftables
apparmor
apparmor-utils
chrony
openssh-client
git
curl
ca-certificates
openssl

# Everything BAU's install.sh needs, so a laptop installed from this stick is finished
# with no network (install.sh --offline; tests/test_full_stick.py keeps this complete).
podman
uidmap
auditd
unattended-upgrades
bind9-dnsutils
ffmpeg

# Encrypted storage setup (jarvis-storage)
fdisk
util-linux
e2fsprogs

# llama.cpp runtime (built from source by image/build-live.sh)
libgomp1
libssl3t64

# Diagnostics and recovery
pciutils
usbutils
lshw
htop
less
nano

# Firmware for common laptops: Wi-Fi, graphics, sound (explicit: the installer-style
# firmware packages such as firmware-b43-installer download at install time and are left out)
firmware-linux-free
firmware-misc-nonfree
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-brcm80211
firmware-mediatek
firmware-amd-graphics
firmware-intel-graphics
firmware-intel-sound
firmware-sof-signed
intel-microcode
amd64-microcode
