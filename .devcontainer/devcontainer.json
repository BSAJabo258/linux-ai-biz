{
  // GitHub Codespaces: try BAU in the browser (development and testing only -
  // GitHub's terms forbid hosting production-facing applications in Codespaces).
  // The real business runs on the laptop installed from the two USB sticks.
  "name": "BAU test drive",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "hostRequirements": { "cpus": 2 },
  "features": {
    // `gh codespace ssh` (GitHub's tunnel, your login only): run checks from another computer.
    "ghcr.io/devcontainers/features/sshd:1": {},
    // Claude Code in the terminal: type `claude` and sign in with your Claude account.
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "containerEnv": {
    "BAU_HOME": "/workspaces/.bau-home"
  },
  "remoteEnv": {
    "BAU_UI_ALLOWED_HOSTS": "${containerEnv:CODESPACE_NAME}-8765.${containerEnv:GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN},${containerEnv:CODESPACE_NAME}-8766.${containerEnv:GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN}"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  // bau init adds newly shipped registry records (your approvals are kept).
  "postStartCommand": "bau init >/dev/null; nohup bau ui --port 8765 > /tmp/bau-ui.log 2>&1 &",
  // Both ports stay private: only your GitHub login can open them (computer or phone).
  "forwardPorts": [8765, 8766],
  "portsAttributes": {
    "8765": { "label": "Mission Control", "onAutoForward": "openBrowser" },
    "8766": { "label": "Jarvis", "onAutoForward": "notify" }
  },
  "customizations": {
    "codespaces": { "openFiles": [".devcontainer/README.md"] }
  }
}
