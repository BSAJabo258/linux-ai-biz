[Unit]
Description=BAU regulation watcher (official-source change detection, review deadlines)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bau
Group=bau
Environment=BAU_HOME=/var/lib/bau
Environment=BAU_AUDIT_KEY=/etc/bau/audit.key
ExecStart=/usr/local/bin/bau reg watch
ExecStartPost=/bin/sh -c '/usr/local/bin/bau status --brief > /var/lib/bau/reports/status-latest.json || true'
UMask=0007
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/bau
CapabilityBoundingSet=
